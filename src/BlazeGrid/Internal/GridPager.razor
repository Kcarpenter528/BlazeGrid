@namespace BlazeGrid.Internal
@typeparam TItem

@{
    int page = Grid.PageIndex, pages = Grid.PageCount, size = Grid.CurrentPageSize;
    int buttons = Math.Max(1, Grid.PagerButtonCount);
    // Pages are shown in fixed blocks (1-10, 11-20, …) so the numbers don't shift under the pointer.
    int from = page / buttons * buttons, to = Math.Min(pages - 1, from + buttons - 1);
    int total = Grid.TotalItemCount;
    int first = total == 0 ? 0 : page * size + 1, last = Math.Min(total, (page + 1) * size);
}
<div class="bz-pager">
    <div class="bz-pager-nav">
        <button type="button" class="bz-pbtn bz-pbtn-edge" disabled="@(page == 0)" title="First page" @onclick="() => Grid.SetPageAsync(0)">«</button>
        <button type="button" class="bz-pbtn bz-pbtn-edge" disabled="@(page == 0)" title="Previous page" @onclick="() => Grid.SetPageAsync(page - 1)">‹</button>
        @if (from > 0)
        {
            <button type="button" class="bz-pbtn bz-pbtn-more" title="Previous pages" @onclick="() => Grid.SetPageAsync(from - 1)">…</button>
        }
        @for (int p = from; p <= to; p++)
        {
            var target = p;
            <button type="button" class="@(p == page ? "bz-pbtn bz-on" : "bz-pbtn")" @onclick="() => Grid.SetPageAsync(target)">@(p + 1)</button>
        }
        @if (to < pages - 1)
        {
            <button type="button" class="bz-pbtn bz-pbtn-more" title="Next pages" @onclick="() => Grid.SetPageAsync(to + 1)">…</button>
        }
        <button type="button" class="bz-pbtn bz-pbtn-edge" disabled="@(page >= pages - 1)" title="Next page" @onclick="() => Grid.SetPageAsync(page + 1)">›</button>
        <button type="button" class="bz-pbtn bz-pbtn-edge" disabled="@(page >= pages - 1)" title="Last page" @onclick="() => Grid.SetPageAsync(pages - 1)">»</button>
    </div>
    @if (Grid.ShowPageSizeSelector)
    {
        <label class="bz-pager-size">
            <select @onchange="e => Grid.SetPageSizeAsync(int.Parse((string)e.Value!))">
                @foreach (var s in Grid.PageSizeOptions)
                {
                    <option value="@s" selected="@(s == size)">@s</option>
                }
            </select>
            per page
        </label>
    }
    <span class="bz-pager-info">@first.ToString("N0") - @last.ToString("N0") of @total.ToString("N0") items</span>
</div>

@code {
    [Parameter] public BzGrid<TItem> Grid { get; set; } = default!;
}
