<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazeGrid</RootNamespace>
    <PackageId>BlazeGrid</PackageId>
    <Version>0.1.1</Version>
    <Description>A high-performance virtualized data grid for Blazor WebAssembly with a Web Worker data engine.</Description>
    <PackageTags>blazor;grid;datagrid;wasm;virtualization</PackageTags>
    <!-- The XML doc file feeds IntelliSense and the API docs (tools/DocGen). CS1591: internals stay undocumented. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);BL0005;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" />
  </ItemGroup>

</Project>
