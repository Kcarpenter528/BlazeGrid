<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates docs/data/api.json from the BlazeGrid assembly, its XML doc file, source regions and bzgrid.css.
       Run from the repo root: dotnet run (project tools/DocGen). See Program.cs. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazeGrid\BlazeGrid.csproj" />
  </ItemGroup>

</Project>
