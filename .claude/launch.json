{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blazegrid-demo",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "samples/BlazeGrid.Demo",
        "--urls",
        "http://localhost:5178"
      ],
      "port": 5178
    },
    {
      "name": "blazegrid-demo-release",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "-c",
        "Release",
        "--project",
        "samples/BlazeGrid.Demo",
        "--urls",
        "http://localhost:5179"
      ],
      "port": 5179
    },
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--directory",
        "docs"
      ],
      "port": 5180
    }
  ]
}